[flake8]
max-line-length = 100
exclude = 
    .git,
    __pycache__,
    .venv,
    myenv,
    venv,
    migrations,
    build,
    dist,
    .eggs,
    *.egg

ignore = 
    E203,
    W503,
    E501,
    E402

per-file-ignores =
    __init__.py: F401
    models.py: E501

count = True
statistics = True
